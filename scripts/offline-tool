#!/usr/bin/env bash
set -euo pipefail

# Start a fresh Linux network namespace, then run as the runner user with a
# minimal environment. The package install runs before calling this script.
exec sudo unshare --net -- setpriv --reuid "$(id -u)" --regid "$(id -g)" --init-groups \
  env -i PATH="$PATH" NODE_ENV=test LLM_MODE=mock CI=true \
  NPM_CONFIG_USERCONFIG=/dev/null NPM_CONFIG_GLOBALCONFIG=/dev/null \
  NPM_CONFIG_CACHE="${REX_TOOL_NPM_CACHE:-${RUNNER_TEMP:-/tmp}/rex-tool-npm}" \
  "$@"
