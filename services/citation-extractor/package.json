{
  "name": "citation-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-contract.mjs",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:imports": "depcruise --config .dependency-cruiser.cjs src test"
  },
  "dependencies": {
    "@fastify/sensible": "6.0.8",
    "@fastify/under-pressure": "9.2.2",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "env-schema": "8.0.2",
    "fastify": "5.12.8",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
