# GENERATED - DO NOT EDIT. Source: src/env.ts, src/tool-env.ts and the optional src/llm/env.ts.
# Runtime environment.
NODE_ENV=development

# Service name in logs and probes.
SERVICE_NAME=answer-analysis

# HTTP listen port.
PORT=8080

# Structured log level.
LOG_LEVEL=info

# Base URI for problem types.
PROBLEM_BASE_URI=https://problems.rex.invalid

# OTLP collector. Export is off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional override of the Fastify request-body limit.
BODY_LIMIT_BYTES=3145728

# Advertise and accept the opt-in GPT-6 Luna analyzer.
ANSWER_ANALYSIS_LUNA_ENABLED=false

# Advertise and accept the opt-in Gemini 2.5 Flash-Lite analyzer.
ANSWER_ANALYSIS_GEMINI_ENABLED=false

# Mock by default in tests, live otherwise.
# LLM_MODE=

# OpenAI credential for live or record mode.
# OPENAI_API_KEY=

# Anthropic credential for live or record mode.
# ANTHROPIC_API_KEY=

# Gemini credential for live or record mode.
# GEMINI_API_KEY=

